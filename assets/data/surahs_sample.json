{
  "surahs": [
    {
      "id": 1,
      "name": "الفاتحة",
      "englishName": "Al-Fatiha",
      "ayahs": [
        {"n": 1, "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"},
        {"n": 2, "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"},
        {"n": 3, "text": "الرَّحْمَٰنِ الرَّحِيمِ"},
        {"n": 4, "text": "مَالِكِ يَوْمِ الدِّينِ"},
        {"n": 5, "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},
        {"n": 6, "text": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"},
        {"n": 7, "text": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"}
      ]
    },
    {
      "id": 112,
      "name": "الإخلاص",
      "englishName": "Al-Ikhlas",
      "ayahs": [
        {"n": 1, "text": "قُلْ هُوَ اللَّهُ أَحَدٌ"},
        {"n": 2, "text": "اللَّهُ الصَّمَدُ"},
        {"n": 3, "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ"},
        {"n": 4, "text": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ"}
      ]
    },
    {
      "id": 113,
      "name": "الفلق",
      "englishName": "Al-Falaq",
      "ayahs": [
        {"n": 1, "text": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ"},
        {"n": 2, "text": "مِن شَرِّ مَا خَلَقَ"},
        {"n": 3, "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},
        {"n": 4, "text": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ"},
        {"n": 5, "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}
      ]
    },
    {
      "id": 114,
      "name": "الناس",
      "englishName": "An-Nas",
      "ayahs": [
        {"n": 1, "text": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ"},
        {"n": 2, "text": "مَلِكِ النَّاسِ"},
        {"n": 3, "text": "إِلَٰهِ النَّاسِ"},
        {"n": 4, "text": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ"},
        {"n": 5, "text": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ"},
        {"n": 6, "text": "مِنَ الْجِنَّةِ وَالنَّاسِ"}
      ]
    }
  ]
}
